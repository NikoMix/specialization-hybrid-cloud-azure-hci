# Normalise line endings so the shell scripts the GitHub Actions runners
# execute always arrive with LF — a CRLF shebang line fails on Linux with
# `/usr/bin/env: 'bash\r': No such file or directory`.
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf

# Binary workfiles must never be line-ending normalised.
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.png   binary
*.jpg   binary
*.svg   text eol=lf
